# Backend-only secret. Never add this file with a real key to source control.
GEMINI_API_KEY=

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides; defaults point to backend/models.
# MODEL_PATH=backend/models/best_model.joblib
# MODEL_METADATA_PATH=backend/models/model_metadata.json
LOG_LEVEL=INFO
